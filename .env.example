# Backend (apps/intelligence)
CMC_API_KEY=your_coinmarketcap_startup_key_here
CMC_BASE_URL=https://pro-api.coinmarketcap.com
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SANDBOX_API_KEY=your_local_dev_api_key_placeholder
ENGINE_VERSION=cointrac-intelligence-v1.0.0
CORS_ORIGINS=http://localhost:3000
FORCE_SIMULATE_BASIC_TIER=false
# Quota profile: startup (default TTL 1.0, 450k credits/mo), basic (default TTL 2.5, 10k credits/mo), adaptive (dynamic TTL by budget state)
CMC_QUOTA_PROFILE=startup
# Optional explicit TTL multiplier override (0.5 - 12.0). Leave unset to use CMC_QUOTA_PROFILE defaults.
# CMC_CACHE_TTL_MULTIPLIER=
# Optional explicit monthly CMC credit budget override. Leave unset to use CMC_QUOTA_PROFILE defaults.
# CMC_MONTHLY_CREDIT_BUDGET=
# Lightweight background cache warmer (set true on Basic/production VPS)
CMC_WARMER_ENABLED=false

# Phase 5 Remote MCP transport & security settings
# Require Authorization: Bearer <key> or x-cointrac-key on /mcp
MCP_REQUIRE_API_KEY=true
# Stateless Streamable HTTP is the default for safe multi-worker cloud scaling
MCP_STATELESS_HTTP=true
# Explicit DNS rebinding protection allowlists (wildcards like * are rejected at startup)
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
MCP_TOOL_TIMEOUT_SECONDS=25.0
MCP_MAX_BODY_BYTES=1048576
# Set ONLY when a verified public HTTPS Remote MCP host is actually deployed (leave empty otherwise)
REMOTE_MCP_PUBLIC_URL=

# Frontend server (apps/web). Read only in server code.
INTELLIGENCE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MCP_PUBLIC_URL=http://localhost:8000/mcp
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Production names only. Set these in Vercel or on the VPS. Do not put secrets in this file.
# Vercel: NEXT_PUBLIC_SITE_URL=https://cointrac.xyz
# Vercel: INTELLIGENCE_API_URL=https://api.cointrac.xyz
# Vercel: NEXT_PUBLIC_MCP_PUBLIC_URL=https://mcp.cointrac.xyz/mcp
# VPS:    PUBLIC_API_BASE_URL=https://api.cointrac.xyz
# VPS:    TRUSTED_HOSTS=api.cointrac.xyz,mcp.cointrac.xyz,localhost,127.0.0.1
# VPS:    CORS_ORIGINS=https://cointrac.xyz,https://www.cointrac.xyz
# VPS:    REMOTE_MCP_PUBLIC_URL=https://mcp.cointrac.xyz/mcp
# VPS:    OAUTH_ISSUER=https://api.cointrac.xyz
# VPS:    OAUTH_RESOURCE=https://mcp.cointrac.xyz/mcp
# VPS:    OAUTH_SIGNING_KID=cointrac-mcp-1
# VPS:    OAUTH_SIGNING_KEY_PATH=  (ES256 PEM outside the repo; never commit it)
# VPS:    OAUTH_DATABASE_URL=  (postgres URL on the host; never commit it)
# VPS:    OAUTH_PREVIOUS_PUBLIC_JWKS=  (public JWKs only, optional)
# Leave the assignments above on their local defaults when running npm run dev.
